// Cloudflare Workers, static assets only: `next build` exports the site to out/ and `wrangler deploy` uploads it.
// Deployed by .github/workflows/deploy.yml on every push to main. Live at https://varshith.oyevarshith.workers.dev
{
  "name": "varshith",
  "account_id": "41fa624f43e6c83beda50cf5730467ad",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./out",
    // unknown paths get out/404.html (Next's not-found page) with a real 404 status
    "not_found_handling": "404-page"
  }
}
